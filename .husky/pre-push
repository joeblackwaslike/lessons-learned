#!/bin/sh
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
# beads sync (non-fatal — never blocks git ops)
command -v bd >/dev/null 2>&1 && bd hooks run pre-push "$@" || true

# Eval gate: every scenario must appear in the latest results before pushing
node scripts/check-scenarios-run.mjs --new-only || exit 1

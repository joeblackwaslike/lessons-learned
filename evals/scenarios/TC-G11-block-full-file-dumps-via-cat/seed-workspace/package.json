{
  "name": "my-app",
  "version": "2.3.1",
  "description": "A full-stack web application with API and frontend",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && rollup -c",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json,css}'",
    "typecheck": "tsc --noEmit",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "docker:build": "docker build -t my-app .",
    "docker:run": "docker-compose up -d",
    "release": "semantic-release"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "lodash": "^4.17.21",
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "winston": "^3.10.0",
    "zod": "^3.22.2",
    "uuid": "^9.0.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.1",
    "pg": "^8.11.3",
    "redis": "^4.6.7",
    "ioredis": "^5.3.2",
    "bull": "^4.11.3",
    "nodemailer": "^6.9.4",
    "handlebars": "^4.7.7",
    "stripe": "^12.16.0",
    "aws-sdk": "^2.1431.0",
    "sharp": "^0.32.4",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.1"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "rollup": "^3.28.0",
    "@rollup/plugin-typescript": "^11.1.2",
    "@types/node": "^20.4.5",
    "@types/express": "^4.17.17",
    "@types/lodash": "^4.14.196",
    "@types/cors": "^2.8.13",
    "@types/compression": "^1.7.2",
    "@types/morgan": "^1.9.4",
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/pg": "^8.10.2",
    "@types/nodemailer": "^6.4.9",
    "@types/multer": "^1.4.7",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.3",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "playwright": "^1.37.0",
    "eslint": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "prettier": "^3.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "semantic-release": "^21.0.7",
    "knex": "^2.5.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/my-app.git"
  },
  "keywords": ["api", "typescript", "express", "postgresql"],
  "author": "Example Corp <eng@example.com>"
}
